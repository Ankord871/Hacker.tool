// VK lookup
async function searchVK() {
  const id = document.getElementById('vk-id').value.trim();
  if (!id) { toast('Enter VK ID or screen name'); return; }
  const el = document.getElementById('vk-result');
  el.textContent = 'Searching...';
  el.classList.remove('empty');
  try {
    const resp = await fetch(`https://api.vk.com/method/users.get?user_ids=${encodeURIComponent(id)}&v=5.131&fields=photo_200,sex,bdate,city,country,online,status,last_seen,site,about,activities,interests,music,movies,tv,books,games`);
    const data = await resp.json();
    if (data.error) {
      el.textContent = 'VK API Error: ' + data.error.error_msg;
      return;
    }
    if (!data.response || data.response.length === 0) {
      el.textContent = 'User not found';
      return;
    }
    const u = data.response[0];
    let html = `<div><strong>${u.first_name} ${u.last_name}</strong> (ID: ${u.id})</div>`;
    if (u.photo_200) html += `<img src="${u.photo_200}" class="vk-photo" alt="photo"><br>`;
    if (u.sex) html += `<div>Sex: ${u.sex === 1 ? 'Female' : 'Male'}</div>`;
    if (u.bdate) html += `<div>Birthday: ${u.bdate}</div>`;
    if (u.city) html += `<div>City: ${u.city.title}</div>`;
    if (u.country) html += `<div>Country: ${u.country.title}</div>`;
    if (u.online !== undefined) html += `<div>Online: ${u.online ? 'Yes' : 'No'}</div>`;
    if (u.status) html += `<div>Status: ${u.status}</div>`;
    if (u.site) html += `<div>Website: ${u.site}</div>`;
    if (u.about) html += `<div>About: ${u.about}</div>`;
    if (u.activities) html += `<div>Activities: ${u.activities}</div>`;
    if (u.interests) html += `<div>Interests: ${u.interests}</div>`;
    if (u.music) html += `<div>Music: ${u.music}</div>`;
    if (u.movies) html += `<div>Movies: ${u.movies}</div>`;
    if (u.tv) html += `<div>TV: ${u.tv}</div>`;
    if (u.books) html += `<div>Books: ${u.books}</div>`;
    if (u.games) html += `<div>Games: ${u.games}</div>`;
    if (u.last_seen) html += `<div>Last seen: ${new Date(u.last_seen.time * 1000).toLocaleString()}</div>`;
    el.innerHTML = html;
  } catch (e) {
    el.textContent = 'Error: ' + e.message;
  }
}

// Phone lookup via Veriphone (requires API key)
function searchPhone() {
  const phone = document.getElementById('phone-number').value.trim();
  const key = document.getElementById('phone-api-key').value.trim();
  if (!phone) { toast('Enter phone number'); return; }
  if (!key) { toast('Enter Veriphone API key (get at veriphone.com)'); return; }
  // Save key to localStorage
  localStorage.setItem('veriphone_key', key);
  const el = document.getElementById('phone-result');
  el.textContent = 'Looking up...';
  el.classList.remove('empty');
  fetch(`https://api.veriphone.com/v1/verify?phone=${encodeURIComponent(phone)}&key=${key}`)
    .then(res => res.json())
    .then(data => {
      if (data.status === 'success') {
        let out = `Phone: ${data.phone}\n`;
        out += `Country: ${data.country} (${data.country_code})\n`;
        out += `Carrier: ${data.carrier || '—'}\n`;
        out += `Line type: ${data.line_type || '—'}\n`;
        out += `Location: ${data.location || '—'}\n`;
        out += `Valid: ${data.valid ? 'Yes' : 'No'}\n`;
        el.textContent = out;
      } else {
        el.textContent = 'Error: ' + (data.error || 'Unknown error');
      }
    })
    .catch(e => el.textContent = 'Error: ' + e.message);
}

// Email breach check via HIBP
async function searchEmail() {
  const email = document.getElementById('email-input').value.trim();
  if (!email) { toast('Enter email address'); return; }
  const el = document.getElementById('email-result');
  el.textContent = 'Checking...';
  el.classList.remove('empty');
  try {
    const resp = await fetch(`https://haveibeenpwned.com/api/v3/breachedaccount/${encodeURIComponent(email)}`);
    if (resp.status === 404) {
      el.textContent = '✅ No breaches found';
      return;
    }
    if (resp.status !== 200) {
      el.textContent = 'Error: ' + resp.status;
      return;
    }
    const data = await resp.json();
    let out = `⚠️ Breaches found: ${data.length}\n\n`;
    data.forEach(b => {
      out += `- ${b.Name}`;
      if (b.BreachDate) out += ` (${b.BreachDate})`;
      if (b.Domain) out += ` [${b.Domain}]`;
      out += `\n  ${b.Description || ''}`;
      out += `\n  Compromised data: ${b.DataClasses ? b.DataClasses.join(', ') : '—'}\n\n`;
    });
    el.textContent = out;
  } catch (e) {
    el.textContent = 'Error: ' + e.message;
  }
}

// Social media quick links
function openSocial(platform) {
  const username = document.getElementById('social-username').value.trim();
  if (!username) { toast('Enter username'); return; }
  const urls = {
    vk: `https://vk.com/${username}`,
    telegram: `https://t.me/${username}`,
    instagram: `https://instagram.com/${username}`,
    twitter: `https://twitter.com/${username}`,
  };
  const url = urls[platform];
  if (url) window.open(url, '_blank');
  else toast('Unknown platform');
}

