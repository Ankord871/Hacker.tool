<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BREACH // Multitool ++</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0e17;
    --surface: #0f1520;
    --surface2: #141b28;
    --border: #1e2a3f;
    --border-hover: #2a3d5c;
    --green: #00ff88;
    --green-dim: #00cc66;
    --green-glow: rgba(0, 255, 136, 0.35);
    --red: #ff4466;
    --amber: #ffcc33;
    --cyan: #00e5ff;
    --purple: #b366ff;
    --text: #c8d6e5;
    --text-dim: #7a8ba0;
    --radius: 6px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--green);
    font-family: 'IBM Plex Mono', 'JetBrains Mono', monospace;
    overflow-x: hidden;
    min-height: 100vh;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    * { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition: none !important; }
  }

  #matrix {
    position: fixed; inset: 0; z-index: -2; opacity: 0.07;
  }
  #scanlines {
    position: fixed; inset: 0; z-index: 50; pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(0,0,0,0.12), rgba(0,0,0,0.12) 1px, transparent 1px, transparent 3px);
  }

  /* ===== SAWYER EYE — CRT TV + frames from video ===== */
  #sawyer-eye {
    position: fixed;
    bottom: 18px;
    right: 14px;
    width: 148px;
    height: 128px;
    z-index: 90;
    cursor: pointer;
    background: linear-gradient(160deg, #3a2820 0%, #1a100c 40%, #0d0806 100%);
    border-radius: 10px 10px 14px 14px;
    padding: 10px 10px 18px;
    box-shadow:
      0 0 0 1px #5a4030,
      0 0 0 3px #1a1008,
      0 8px 24px rgba(0,0,0,0.7),
      0 0 40px rgba(180, 40, 20, 0.12);
    transition: transform 0.2s ease;
  }
  #sawyer-eye:hover { transform: scale(1.05); }
  #sawyer-eye .crt-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    overflow: hidden;
    background: #02040c;
    box-shadow: inset 0 0 20px rgba(0,0,0,0.85);
  }
  #sawyer-eye .eye-layer {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 0.1s ease;
  }
  #sawyer-eye .eye-layer.active { opacity: 1; }
  #sawyer-eye .eye-open   { background-image: url('eye_open1.jpg'); }
  #sawyer-eye .eye-open2  { background-image: url('eye_open2.jpg'); }
  #sawyer-eye .eye-closed { background-image: url('eye_closed2.jpg'); }
  #sawyer-eye .eye-angry  { background-image: url('eye_angry.jpg'); }
  #sawyer-eye .vhs-scan {
    position: absolute; inset: 0; z-index: 5; pointer-events: none;
    background: repeating-linear-gradient(
      0deg, transparent 0px, transparent 2px,
      rgba(0,0,0,0.25) 2px, rgba(0,0,0,0.25) 3px
    );
    opacity: 0.7;
  }
  #sawyer-eye .vhs-noise {
    position: absolute; inset: 0; z-index: 4; pointer-events: none;
    opacity: 0.12;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    mix-blend-mode: overlay;
    animation: noiseShift 0.35s steps(2) infinite;
  }
  @keyframes noiseShift {
    0% { transform: translate(0,0); }
    50% { transform: translate(-1%,1%); }
    100% { transform: translate(1%,-1%); }
  }
  #sawyer-eye .vhs-chroma {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    box-shadow: 1px 0 0 rgba(255,40,60,0.18), -1px 0 0 rgba(40,200,255,0.18);
    opacity: 0.55;
  }
  #sawyer-eye .crt-glow {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 35%, rgba(0,0,0,0.5) 100%);
  }
  #sawyer-eye .crt-label {
    position: absolute;
    bottom: 3px; left: 0; right: 0;
    text-align: center;
    font-size: 7px;
    letter-spacing: 1.5px;
    color: #8a6050;
    text-transform: uppercase;
    opacity: 0.75;
  }
  #sawyer-eye.glitch .crt-screen {
    animation: tvGlitch 0.22s steps(2);
  }
  @keyframes tvGlitch {
    0% { filter: none; transform: none; }
    30% { filter: hue-rotate(80deg); transform: translateX(-2px); }
    60% { filter: invert(0.08); transform: translateX(2px); }
    100% { filter: none; transform: none; }
  }
  @media (max-width: 600px) {
    #sawyer-eye { width: 110px; height: 96px; bottom: 10px; right: 8px; padding: 8px 8px 14px; }
    #sawyer-eye .crt-label { font-size: 6px; }
  }

  .app {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 16px 40px;
    position: relative;
    z-index: 2;
  }

  header {
    position: sticky; top: 0; z-index: 100;
    background: linear-gradient(180deg, rgba(10,14,23,0.97) 60%, transparent);
    padding: 14px 0;
    display: flex; justify-content: space-between; align-items: center;
    border-bottom: 1px solid var(--border);
    margin-bottom: 20px;
  }
  .logo {
    font-size: 16px; font-weight: 700; letter-spacing: 3px;
    color: var(--green);
  }
  .logo span { opacity: 0.5; }
  .header-status {
    display: flex; gap: 18px; align-items: center; font-size: 11px; letter-spacing: 1px;
  }
  .status-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--green); box-shadow: 0 0 8px var(--green);
    animation: pulse 1.8s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  .status-offline .status-dot { background: var(--red); box-shadow: 0 0 8px var(--red); }

  .tabs {
    display: flex; gap: 4px; margin-bottom: 20px; flex-wrap: wrap;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 4px;
  }
  .tab {
    flex: 1; min-width: 60px;
    padding: 10px 10px; border: none; background: transparent;
    color: var(--text-dim); font-family: inherit; font-size: 10px;
    letter-spacing: 0.5px; text-transform: uppercase; cursor: pointer;
    border-radius: 4px; transition: all 0.2s;
  }
  .tab:hover { color: var(--green); background: rgba(0,255,136,0.06); }
  .tab.active {
    background: rgba(0,255,136,0.12); color: var(--green);
    box-shadow: inset 0 0 0 1px rgba(0,255,136,0.25);
  }

  .panel { display: none; animation: fadeIn 0.25s ease; }
  .panel.active { display: block; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px;
    margin-bottom: 16px;
  }
  .card-title {
    font-size: 11px; letter-spacing: 2px; color: var(--text-dim);
    text-transform: uppercase; margin-bottom: 14px;
    display: flex; align-items: center; gap: 8px;
  }
  .card-title::before {
    content: '›'; color: var(--green); font-weight: 700;
  }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  @media (max-width: 900px) {
    .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .grid-4 { grid-template-columns: 1fr 1fr; }
  }

  .metric {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    text-align: center;
  }
  .metric-value {
    font-size: 1.4rem; font-weight: 700; color: var(--green);
    text-shadow: 0 0 12px var(--green-glow);
    margin-bottom: 4px; word-break: break-all;
  }
  .metric-label {
    font-size: 10px; letter-spacing: 1.5px; color: var(--text-dim); text-transform: uppercase;
  }

  .info-row {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding: 8px 0; border-bottom: 1px solid var(--border);
    font-size: 13px; gap: 12px;
  }
  .info-row:last-child { border-bottom: none; }
  .info-key { color: var(--text-dim); flex-shrink: 0; }
  .info-val { color: var(--text); text-align: right; word-break: break-all; }

  .terminal {
    background: #05080f;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    height: 420px;
    display: flex; flex-direction: column;
    overflow: hidden;
  }
  .terminal-header {
    background: var(--surface2);
    padding: 8px 14px;
    font-size: 11px; letter-spacing: 1px; color: var(--text-dim);
    border-bottom: 1px solid var(--border);
    display: flex; justify-content: space-between;
  }
  .terminal-body {
    flex: 1; overflow-y: auto; padding: 12px 14px;
    font-size: 13px; line-height: 1.6;
  }
  .terminal-body::-webkit-scrollbar { width: 6px; }
  .terminal-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
  .term-line { margin-bottom: 2px; white-space: pre-wrap; word-break: break-word; }
  .term-cmd { color: var(--green); }
  .term-out { color: var(--text); }
  .term-err { color: var(--red); }
  .term-info { color: var(--cyan); }
  .term-warn { color: var(--amber); }
  .terminal-input-row {
    display: flex; align-items: center; padding: 10px 14px;
    border-top: 1px solid var(--border); background: var(--surface);
  }
  .terminal-input-row .prompt { color: var(--green); margin-right: 8px; white-space: nowrap; }
  #term-input {
    flex: 1; background: transparent; border: none; outline: none;
    color: var(--green); font-family: inherit; font-size: 13px;
  }

  .form-group { margin-bottom: 14px; }
  .form-label {
    display: block; font-size: 11px; letter-spacing: 1px;
    color: var(--text-dim); margin-bottom: 6px; text-transform: uppercase;
  }
  input[type="text"], input[type="password"], input[type="number"], textarea, select {
    width: 100%; background: var(--surface2);
    border: 1px solid var(--border); border-radius: 4px;
    padding: 10px 12px; color: var(--text);
    font-family: inherit; font-size: 13px; outline: none;
    transition: border-color 0.2s;
  }
  input:focus, textarea:focus, select:focus {
    border-color: var(--green); box-shadow: 0 0 0 1px rgba(0,255,136,0.2);
  }
  textarea { min-height: 80px; resize: vertical; }
  select { cursor: pointer; }

  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 16px; border: 1px solid var(--green);
    background: transparent; color: var(--green);
    font-family: inherit; font-size: 12px; letter-spacing: 1px;
    text-transform: uppercase; cursor: pointer; border-radius: 4px;
    transition: all 0.2s;
  }
  .btn:hover {
    background: var(--green); color: #000;
    box-shadow: 0 0 16px var(--green-glow);
  }
  .btn-sm { padding: 6px 10px; font-size: 11px; }
  .btn-ghost {
    border-color: var(--border); color: var(--text-dim);
  }
  .btn-ghost:hover {
    border-color: var(--green); color: var(--green); background: transparent; box-shadow: none;
  }
  .btn-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
  .btn:disabled { opacity: 0.4; pointer-events: none; }

  .result-box {
    background: #05080f;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 12px;
    font-size: 13px; color: var(--text);
    word-break: break-all; min-height: 48px;
    position: relative;
    max-height: 300px; overflow-y: auto;
  }
  .result-box.empty { color: var(--text-dim); }
  .copy-btn {
    position: absolute; top: 8px; right: 8px;
    padding: 4px 8px; font-size: 10px;
  }

  .strength-bar {
    height: 4px; background: var(--border); border-radius: 2px;
    margin-top: 8px; overflow: hidden;
  }
  .strength-fill {
    height: 100%; width: 0%; transition: width 0.3s, background 0.3s;
  }
  .strength-text { font-size: 12px; margin-top: 6px; }

  .toast {
    position: fixed; bottom: 24px; right: 24px; z-index: 200;
    background: var(--surface2); border: 1px solid var(--green);
    color: var(--green); padding: 10px 18px; border-radius: 4px;
    font-size: 12px; letter-spacing: 1px;
    opacity: 0; transform: translateY(12px); transition: all 0.25s;
    pointer-events: none;
  }
  .toast.show { opacity: 1; transform: translateY(0); }

  .cmd-list {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 6px; font-size: 12px;
  }
  .cmd-item {
    background: var(--surface2); border: 1px solid var(--border);
    padding: 8px 10px; border-radius: 4px; cursor: pointer;
    transition: border-color 0.2s;
  }
  .cmd-item:hover { border-color: var(--green); }
  .cmd-name { color: var(--green); font-weight: 600; }
  .cmd-desc { color: var(--text-dim); font-size: 11px; margin-top: 2px; }

  footer {
    text-align: center; padding: 30px 0 10px;
    font-size: 11px; letter-spacing: 2px; color: var(--text-dim);
    border-top: 1px solid var(--border); margin-top: 30px;
  }

  .live-time { font-variant-numeric: tabular-nums; }
  .progress-wrap {
    background: var(--surface2); border-radius: 4px; overflow: hidden;
    height: 20px; border: 1px solid var(--border); margin: 10px 0;
  }
  .progress-bar {
    height: 100%; width: 0%; background: var(--green); transition: width 0.3s;
  }
  .progress-text {
    font-size: 12px; color: var(--text-dim);
    text-align: center;
  }
  .dict-status {
    font-size: 13px; color: var(--text);
  }
  .qr-container {
    display: flex; justify-content: center; margin: 10px 0;
  }
  .qr-container img {
    background: white; padding: 10px; border-radius: 4px;
    max-width: 200px;
  }
  .notes-area {
    min-height: 150px;
  }
  .timer-display {
    font-size: 2rem; text-align: center; color: var(--green);
    letter-spacing: 4px;
    font-variant-numeric: tabular-nums;
  }
  .weather-icon {
    font-size: 2rem;
  }
  .vk-photo {
    width: 100px; height: 100px; border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--green);
    margin-top: 6px;
  }
</style>
</head>
<body>
<canvas id="matrix"></canvas>
<div id="scanlines"></div>

<div class="app">
  <header>
    <div class="logo"><span>[</span> BREACH <span>]</span> // MULTITOOL ++</div>
    <div class="header-status" id="net-status">
      <div class="status-dot"></div>
      <span id="net-label">SYSTEM ONLINE</span>
      <span class="live-time" id="live-clock">--:--:--</span>
    </div>
  </header>

  <div class="tabs" id="main-tabs">
    <button class="tab active" data-panel="dashboard">Dashboard</button>
    <button class="tab" data-panel="terminal">Terminal</button>
    <button class="tab" data-panel="tools">Tools</button>
    <button class="tab" data-panel="encode">Encode</button>
    <button class="tab" data-panel="security">Security</button>
    <button class="tab" data-panel="network">Network</button>
    <button class="tab" data-panel="crypto">Crypto</button>
    <button class="tab" data-panel="bruteforce">Bruteforce</button>
    <button class="tab" data-panel="recon">Recon</button>
    <button class="tab" data-panel="daily">Daily</button>
    <button class="tab" data-panel="geoip">GeoIP</button>
    <button class="tab" data-panel="osint">OSINT</button>
  </div>

  <!-- DASHBOARD (unchanged) -->
  <div class="panel active" id="panel-dashboard">
    <div class="grid-4" id="metrics-row">
      <div class="metric">
        <div class="metric-value" id="m-ip">...</div>
        <div class="metric-label">Public IP</div>
      </div>
      <div class="metric">
        <div class="metric-value" id="m-city">...</div>
        <div class="metric-label">Location</div>
      </div>
      <div class="metric">
        <div class="metric-value" id="m-isp">...</div>
        <div class="metric-label">ISP / Org</div>
      </div>
      <div class="metric">
        <div class="metric-value" id="m-battery">—</div>
        <div class="metric-label">Battery</div>
      </div>
    </div>

    <div class="grid-2" style="margin-top:16px">
      <div class="card">
        <div class="card-title">System Info</div>
        <div id="sys-info"></div>
      </div>
      <div class="card">
        <div class="card-title">Network & Session</div>
        <div id="net-info"></div>
      </div>
    </div>

    <div class="card" style="margin-top:0">
      <div class="card-title">Quick Actions</div>
      <div class="btn-row">
        <button class="btn btn-sm" onclick="switchTab('terminal'); focusTerm()">Open Terminal</button>
        <button class="btn btn-sm" onclick="refreshAll()">Refresh Data</button>
        <button class="btn btn-sm btn-ghost" onclick="copyText(document.getElementById('m-ip').textContent)">Copy IP</button>
        <button class="btn btn-sm btn-ghost" onclick="switchTab('network')">HTTP Client</button>
        <button class="btn btn-sm btn-ghost" onclick="switchTab('daily')">Daily Tools</button>
        <button class="btn btn-sm btn-ghost" onclick="switchTab('geoip')">GeoIP Details</button>
      </div>
    </div>
  </div>

  <!-- TERMINAL (unchanged) -->
  <div class="panel" id="panel-terminal">
    <div class="terminal">
      <div class="terminal-header">
        <span>root@breach:~</span>
        <span style="color:var(--text-dim)">type <b style="color:var(--green)">help</b> for commands</span>
      </div>
      <div class="terminal-body" id="term-body"></div>
      <div class="terminal-input-row">
        <span class="prompt">$</span>
        <input type="text" id="term-input" autocomplete="off" spellcheck="false" placeholder="enter command...">
      </div>
    </div>

    <div class="card" style="margin-top:16px">
      <div class="card-title">Available Commands</div>
      <div class="cmd-list" id="cmd-list"></div>
    </div>
  </div>

  <!-- TOOLS (unchanged) -->
  <div class="panel" id="panel-tools">
    <div class="grid-2">
      <div class="card">
        <div class="card-title">Hash Generator</div>
        <div class="form-group">
          <label class="form-label">Input text</label>
          <textarea id="hash-input" placeholder="Enter text to hash..."></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Algorithm</label>
          <select id="hash-algo">
            <option value="SHA-256">SHA-256</option>
            <option value="SHA-384">SHA-384</option>
            <option value="SHA-512">SHA-512</option>
            <option value="SHA-1">SHA-1</option>
          </select>
        </div>
        <div class="btn-row">
          <button class="btn" onclick="doHash()">Generate Hash</button>
          <button class="btn btn-ghost btn-sm" onclick="document.getElementById('hash-input').value=''">Clear</button>
        </div>
        <div class="form-group" style="margin-top:14px">
          <label class="form-label">Result</label>
          <div class="result-box empty" id="hash-result">—</div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">JSON Formatter</div>
        <div class="form-group">
          <label class="form-label">JSON input</label>
          <textarea id="json-input" placeholder='{"key": "value"}'></textarea>
        </div>
        <div class="btn-row">
          <button class="btn" onclick="formatJSON(true)">Beautify</button>
          <button class="btn btn-ghost" onclick="formatJSON(false)">Minify</button>
          <button class="btn btn-ghost btn-sm" onclick="document.getElementById('json-input').value=''">Clear</button>
        </div>
        <div class="form-group" style="margin-top:14px">
          <label class="form-label">Output</label>
          <div class="result-box empty" id="json-result">—</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ENCODE (unchanged) -->
  <div class="panel" id="panel-encode">
    <div class="grid-2">
      <div class="card">
        <div class="card-title">Base64</div>
        <div class="form-group">
          <label class="form-label">Input</label>
          <textarea id="b64-input" placeholder="Text or Base64..."></textarea>
        </div>
        <div class="btn-row">
          <button class="btn" onclick="doBase64(true)">Encode</button>
          <button class="btn" onclick="doBase64(false)">Decode</button>
        </div>
        <div class="form-group" style="margin-top:14px">
          <label class="form-label">Result</label>
          <div class="result-box empty" id="b64-result">—</div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">URL Encode / Decode</div>
        <div class="form-group">
          <label class="form-label">Input</label>
          <textarea id="url-input" placeholder="Text or URL-encoded string..."></textarea>
        </div>
        <div class="btn-row">
          <button class="btn" onclick="doURL(true)">Encode</button>
          <button class="btn" onclick="doURL(false)">Decode</button>
        </div>
        <div class="form-group" style="margin-top:14px">
          <label class="form-label">Result</label>
          <div class="result-box empty" id="url-result">—</div>
        </div>
      </div>
    </div>

