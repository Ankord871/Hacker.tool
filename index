async function startBruteforce() {
  const hashAlgo = document.getElementById('bf-algo').value;
  const targetHash = document.getElementById('bf-hash').value.trim();
  const dict = document.getElementById('bf-dict').value;
  if (!targetHash) { toast('Enter target hash'); return; }
  if (!dict) { toast('Load dictionary first'); return; }
  const words = dict.split('\n').map(s => s.trim()).filter(s => s.length > 0);
  if (words.length === 0) { toast('Dictionary empty'); return; }
  bfRunning = true;
  bfStop = false;
  document.getElementById('bf-start').disabled = true;
  document.getElementById('bf-stop').disabled = false;
  const progress = document.getElementById('bf-progress');
  const progressText = document.getElementById('bf-progress-text');
  const resultEl = document.getElementById('bf-result');
  resultEl.textContent = 'Searching...';
  resultEl.classList.remove('empty');

  let found = false;
  const total = words.length;
  let checked = 0;

  for (let i = 0; i < total; i++) {
    if (bfStop) break;
    const word = words[i];
    const hash = await digest(hashAlgo, word);
    checked++;
    if (hash === targetHash) {
      resultEl.textContent = '✅ Found: ' + word;
      found = true;
      toast('Password found!');
      break;
    }
    if (i % 10 === 0) {
      progress.style.width = (checked / total * 100) + '%';
      progressText.textContent = `${checked} / ${total} (${Math.round(checked/total*100)}%)`;
      await new Promise(r => setTimeout(r, 0));
    }
  }
  if (!found && !bfStop) {
    resultEl.textContent = '❌ Not found in dictionary';
  } else if (bfStop) {
    resultEl.textContent = '⏹️ Stopped';
  }
  progress.style.width = '100%';
  progressText.textContent = `Done (${checked} checked)`;
  bfRunning = false;
  document.getElementById('bf-start').disabled = false;
  document.getElementById('bf-stop').disabled = true;
}

