  } catch (e) { toast('Error: ' + e.message); }
}

function doURL(encode) {
  const raw = document.getElementById('url-input').value;
  if (!raw) { toast('Enter text'); return; }
  try {
    const out = encode ? encodeURIComponent(raw) : decodeURIComponent(raw);
