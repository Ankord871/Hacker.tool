  const el = document.getElementById('geoip-details');
  const text = el.textContent;
  const coordMatch = text.match(/Coordinates: ([\d.]+), ([\d.]+)/);
  if (coordMatch) {
    const lat = coordMatch[1];
    const lon = coordMatch[2];
    window.open(`https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}&zoom=12`, '_blank');
  } else {
    toast('Coordinates not found, load GeoIP first');
  }
}

