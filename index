async function sendHttpRequest() {
  const method = document.getElementById('http-method').value;
  const url = document.getElementById('http-url').value.trim();
  if (!url) { toast('Enter URL'); return; }
  const headersRaw = document.getElementById('http-headers').value;
  const headers = {};
  headersRaw.split('\n').forEach(line => {
    const idx = line.indexOf(':');
    if (idx > 0) {
      const key = line.slice(0, idx).trim();
      const val = line.slice(idx + 1).trim();
      if (key && val) headers[key] = val;
    }
  });
  const body = document.getElementById('http-body').value;
  const opts = { method, headers };
  if (body && (method === 'POST' || method === 'PUT' || method === 'PATCH')) {
    opts.body = body;
    if (!headers['Content-Type']) headers['Content-Type'] = 'application/json';
  }
  const respBox = document.getElementById('http-response');
  respBox.textContent = 'Sending...';
  respBox.classList.remove('empty');
  try {
    const resp = await fetch(url, opts);
    const text = await resp.text();
    const out = `Status: ${resp.status} ${resp.statusText}\nHeaders: ${JSON.stringify([...resp.headers.entries()], null, 2)}\nBody:\n${text}`;
    respBox.textContent = out;
  } catch (e) {
    respBox.textContent = 'Error: ' + e.message;
  }
}

/* ========== CRYPTO PANEL ========== */
function hexToBytes(hex) {
  if (hex.length % 2) throw new Error('Invalid hex');
  return new Uint8Array(hex.match(/.{1,2}/g).map(b => parseInt(b, 16)));
}
function bytesToHex(bytes) {
  return [...bytes].map(b => b.toString(16).padStart(2, '0')).join('');
}

function generateAesKey() {
  const mode = document.getElementById('aes-mode').value;
  crypto.subtle.generateKey({ name: mode, length: 256 }, true, ['encrypt', 'decrypt'])
    .then(key => crypto.subtle.exportKey('raw', key))
    .then(raw => {
      const hex = bytesToHex(new Uint8Array(raw));
      document.getElementById('aes-key').value = hex;
      toast('AES key generated');
    })
    .catch(e => toast('Key gen error: ' + e.message));
}

function generateAesIv() {
  const mode = document.getElementById('aes-mode').value;
  const len = mode === 'AES-CBC' ? 16 : 12;
  const arr = new Uint8Array(len);
  crypto.getRandomValues(arr);
  document.getElementById('aes-iv').value = bytesToHex(arr);
}

async function aesEncrypt() {
  const mode = document.getElementById('aes-mode').value;
  const keyHex = document.getElementById('aes-key').value.trim();
  const ivHex = document.getElementById('aes-iv').value.trim();
  const text = document.getElementById('aes-text').value;
  if (!keyHex || !ivHex || !text) { toast('Fill key, IV and text'); return; }
  try {
    const keyData = hexToBytes(keyHex);
    const ivData = hexToBytes(ivHex);
    const key = await crypto.subtle.importKey('raw', keyData, { name: mode, length: keyData.length * 8 }, false, ['encrypt']);
    const enc = await crypto.subtle.encrypt({ name: mode, iv: ivData }, key, new TextEncoder().encode(text));
    const result = bytesToHex(new Uint8Array(enc));
    document.getElementById('aes-result').textContent = result;
    toast('Encrypted');
  } catch (e) { toast('Encrypt error: ' + e.message); }
}

async function aesDecrypt() {
  const mode = document.getElementById('aes-mode').value;
  const keyHex = document.getElementById('aes-key').value.trim();
  const ivHex = document.getElementById('aes-iv').value.trim();
  const hex = document.getElementById('aes-text').value.trim();
  if (!keyHex || !ivHex || !hex) { toast('Fill key, IV and ciphertext (hex)'); return; }
  try {
    const keyData = hexToBytes(keyHex);
    const ivData = hexToBytes(ivHex);
    const ciphertext = hexToBytes(hex);
    const key = await crypto.subtle.importKey('raw', keyData, { name: mode, length: keyData.length * 8 }, false, ['decrypt']);
    const dec = await crypto.subtle.decrypt({ name: mode, iv: ivData }, key, ciphertext);
    const text = new TextDecoder().decode(dec);
    document.getElementById('aes-result').textContent = text;
    toast('Decrypted');
  } catch (e) { toast('Decrypt error: ' + e.message); }
}

async function generateRsaKeypair() {
  try {
    const keypair = await crypto.subtle.generateKey({
      name: 'RSA-OAEP',
      modulusLength: 2048,
      publicExponent: new Uint8Array([1, 0, 1]),
      hash: 'SHA-256'
    }, true, ['encrypt', 'decrypt']);
    const pub = await crypto.subtle.exportKey('spki', keypair.publicKey);
    const priv = await crypto.subtle.exportKey('pkcs8', keypair.privateKey);
    const pubPem = '-----BEGIN PUBLIC KEY-----\n' + btoa(String.fromCharCode(...new Uint8Array(pub))) + '\n-----END PUBLIC KEY-----';
    const privPem = '-----BEGIN PRIVATE KEY-----\n' + btoa(String.fromCharCode(...new Uint8Array(priv))) + '\n-----END PRIVATE KEY-----';
    document.getElementById('rsa-public').value = pubPem;
    document.getElementById('rsa-private').value = privPem;
    toast('RSA keypair generated');
  } catch (e) { toast('RSA gen error: ' + e.message); }
}

function pemToArrayBuffer(pem) {
  const b64 = pem.replace(/-----[^-]+-----/g, '').replace(/\s/g, '');
  const binary = atob(b64);
  const bytes = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
  return bytes.buffer;
}

async function rsaEncrypt() {
  const pubPem = document.getElementById('rsa-public').value.trim();
  const data = document.getElementById('rsa-text').value;
  if (!pubPem || !data) { toast('Enter public key and data'); return; }
  try {
    const pubBuffer = pemToArrayBuffer(pubPem);
    const key = await crypto.subtle.importKey('spki', pubBuffer, { name: 'RSA-OAEP', hash: 'SHA-256' }, false, ['encrypt']);
    const enc = await crypto.subtle.encrypt({ name: 'RSA-OAEP' }, key, new TextEncoder().encode(data));
    const hex = bytesToHex(new Uint8Array(enc));
    document.getElementById('rsa-result').textContent = hex;
    toast('Encrypted');
  } catch (e) { toast('Encrypt error: ' + e.message); }
}

async function rsaDecrypt() {
  const privPem = document.getElementById('rsa-private').value.trim();
  const hex = document.getElementById('rsa-text').value.trim();
  if (!privPem || !hex) { toast('Enter private key and ciphertext (hex)'); return; }
  try {
    const privBuffer = pemToArrayBuffer(privPem);
    const key = await crypto.subtle.importKey('pkcs8', privBuffer, { name: 'RSA-OAEP', hash: 'SHA-256' }, false, ['decrypt']);
    const ciphertext = hexToBytes(hex);
    const dec = await crypto.subtle.decrypt({ name: 'RSA-OAEP' }, key, ciphertext);
    const text = new TextDecoder().decode(dec);
    document.getElementById('rsa-result').textContent = text;
    toast('Decrypted');
  } catch (e) { toast('Decrypt error: ' + e.message); }
}

