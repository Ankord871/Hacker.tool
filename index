async function loadIP() {
  try {
    const r = await fetch('https://ipapi.co/json/');
    const d = await r.json();
    document.getElementById('m-ip').textContent = d.ip || '—';
    document.getElementById('m-city').textContent = [d.city, d.country_name].filter(Boolean).join(', ') || '—';
    document.getElementById('m-isp').textContent = d.org || d.asn || '—';
    return d;
  } catch (e) {
    try {
      const r2 = await fetch('https://api.ipify.org?format=json');
      const d2 = await r2.json();
      document.getElementById('m-ip').textContent = d2.ip;
      document.getElementById('m-city').textContent = '—';
      document.getElementById('m-isp').textContent = '—';
      return { ip: d2.ip };
    } catch {
      document.getElementById('m-ip').textContent = 'unavailable';
      return {};
    }
  }
}

function loadSysInfo() {
  const ua = navigator.userAgent;
  const info = [
    ['Browser', getBrowser()],
    ['Platform', navigator.platform || '—'],
    ['Language', navigator.language || '—'],
    ['Cores', navigator.hardwareConcurrency || '—'],
    ['Memory', navigator.deviceMemory ? navigator.deviceMemory + ' GB' : '—'],
    ['Screen', `${screen.width}×${screen.height}`],
    ['Viewport', `${window.innerWidth}×${window.innerHeight}`],
    ['Pixel Ratio', window.devicePixelRatio || '—'],
    ['Cookies', navigator.cookieEnabled ? 'Enabled' : 'Disabled'],
    ['Online', navigator.onLine ? 'Yes' : 'No'],
  ];
  document.getElementById('sys-info').innerHTML = info.map(([k,v]) =>
    `<div class="info-row"><span class="info-key">${k}</span><span class="info-val">${v}</span></div>`
  ).join('');
}

function getBrowser() {
  const ua = navigator.userAgent;
  if (ua.includes('Firefox/')) return 'Firefox ' + (ua.match(/Firefox\/([\d.]+)/)||[])[1];
  if (ua.includes('Edg/')) return 'Edge ' + (ua.match(/Edg\/([\d.]+)/)||[])[1];
  if (ua.includes('Chrome/')) return 'Chrome ' + (ua.match(/Chrome\/([\d.]+)/)||[])[1];
  if (ua.includes('Safari/') && !ua.includes('Chrome')) return 'Safari';
  return 'Unknown';
}

async function loadBattery() {
  if (!navigator.getBattery) {
    document.getElementById('m-battery').textContent = 'N/A';
    return;
  }
  try {
    const b = await navigator.getBattery();
    const update = () => {
      const pct = Math.round(b.level * 100);
      document.getElementById('m-battery').textContent = pct + '%' + (b.charging ? ' ⚡' : '');
    };
    update();
    b.addEventListener('levelchange', update);
    b.addEventListener('chargingchange', update);
  } catch {
    document.getElementById('m-battery').textContent = 'N/A';
  }
}

function loadNetInfo(ipData = {}) {
  const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
  const rows = [
    ['Public IP', ipData.ip || document.getElementById('m-ip').textContent],
    ['Country', ipData.country_name || '—'],
    ['Region', ipData.region || '—'],
    ['Timezone', ipData.timezone || Intl.DateTimeFormat().resolvedOptions().timeZone],
    ['Connection', conn ? (conn.effectiveType || conn.type || '—') : '—'],
    ['Downlink', conn && conn.downlink ? conn.downlink + ' Mbps' : '—'],
    ['RTT', conn && conn.rtt != null ? conn.rtt + ' ms' : '—'],
    ['User Agent', navigator.userAgent.slice(0, 60) + '…'],
  ];
  document.getElementById('net-info').innerHTML = rows.map(([k,v]) =>
    `<div class="info-row"><span class="info-key">${k}</span><span class="info-val">${v}</span></div>`
  ).join('');
}

