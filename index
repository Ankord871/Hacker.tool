  } catch (e) { toast('Error: ' + e.message); }
}

function doHex(toHex) {
  const raw = document.getElementById('hex-input').value.trim();
  if (!raw) { toast('Enter text'); return; }
  try {
    let out;
    if (toHex) {
      out = [...new TextEncoder().encode(raw)].map(b => b.toString(16).padStart(2, '0')).join(' ');
    } else {
      const clean = raw.replace(/\s+/g, '');
      if (clean.length % 2) throw new Error('Odd length hex');
      const bytes = new Uint8Array(clean.match(/.{1,2}/g).map(h => parseInt(h, 16)));
      out = new TextDecoder().decode(bytes);
    }
    const el = document.getElementById('hex-result');
    el.classList.remove('empty');
    el.textContent = out;
  } catch (e) { toast('Error: ' + e.message); }
}

/* ========== PASSWORD ========== */
document.getElementById('pw-len').addEventListener('input', e => {
  document.getElementById('pw-len-val').textContent = e.target.value;
});

function generatePassword(len, upper, lower, num, sym) {
  let chars = '';
  if (upper) chars += 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  if (lower) chars += 'abcdefghijklmnopqrstuvwxyz';
  if (num) chars += '0123456789';
  if (sym) chars += '!@#$%^&*()_+-=[]{}|;:,.<>?';
  if (!chars) chars = 'abcdefghijklmnopqrstuvwxyz';
  const arr = new Uint32Array(len);
  crypto.getRandomValues(arr);
  return Array.from(arr, x => chars[x % chars.length]).join('');
}

function genPassword() {
  const len = +document.getElementById('pw-len').value;
  const pw = generatePassword(
    len,
    document.getElementById('pw-upper').checked,
    document.getElementById('pw-lower').checked,
    document.getElementById('pw-num').checked,
    document.getElementById('pw-sym').checked
  );
  const el = document.getElementById('pw-result');
  el.classList.remove('empty');
  el.textContent = pw;
}

function checkStrength() {
  const pw = document.getElementById('str-input').value;
  const fill = document.getElementById('str-fill');
  const text = document.getElementById('str-text');
  const details = document.getElementById('str-details');
  if (!pw) {
    fill.style.width = '0%';
    text.textContent = 'Enter a password';
    details.textContent = '';
    return;
  }
  let score = 0;
  const checks = [];
  if (pw.length >= 8) { score += 20; checks.push('✓ Length ≥ 8'); } else checks.push('✗ Length < 8');
  if (pw.length >= 12) { score += 15; checks.push('✓ Length ≥ 12'); }
  if (pw.length >= 16) { score += 10; checks.push('✓ Length ≥ 16'); }
  if (/[a-z]/.test(pw)) { score += 15; checks.push('✓ Lowercase'); } else checks.push('✗ No lowercase');
  if (/[A-Z]/.test(pw)) { score += 15; checks.push('✓ Uppercase'); } else checks.push('✗ No uppercase');
  if (/[0-9]/.test(pw)) { score += 15; checks.push('✓ Numbers'); } else checks.push('✗ No numbers');
  if (/[^a-zA-Z0-9]/.test(pw)) { score += 15; checks.push('✓ Symbols'); } else checks.push('✗ No symbols');
  score = Math.min(100, score);
  fill.style.width = score + '%';
  if (score < 40) { fill.style.background = 'var(--red)'; text.style.color = 'var(--red)'; text.textContent = 'Weak'; }
  else if (score < 70) { fill.style.background = 'var(--amber)'; text.style.color = 'var(--amber)'; text.textContent = 'Medium'; }
  else { fill.style.background = 'var(--green)'; text.style.color = 'var(--green)'; text.textContent = 'Strong'; }
  details.innerHTML = checks.join('<br>');
}

