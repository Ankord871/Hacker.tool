/* ========== CRYPTO UTILS ========== */
async function sha256(str) {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
  return [...new Uint8Array(buf)].map(b => b.toString(16).padStart(2, '0')).join('');
}
async function digest(algo, str) {
  const buf = await crypto.subtle.digest(algo, new TextEncoder().encode(str));
  return [...new Uint8Array(buf)].map(b => b.toString(16).padStart(2, '0')).join('');
}

async function doHash() {
  const text = document.getElementById('hash-input').value;
  const algo = document.getElementById('hash-algo').value;
  if (!text) { toast('Enter text'); return; }
  try {
    const h = await digest(algo, text);
    const el = document.getElementById('hash-result');
    el.classList.remove('empty');
    el.innerHTML = h + ` <button class="btn btn-sm btn-ghost copy-btn" onclick="copyText('${h}')">Copy</button>`;
  } catch (e) { toast('Hash error: ' + e.message); }
}

function formatJSON(pretty) {
