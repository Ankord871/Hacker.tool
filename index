/* ========== SAWYER EYE ========== */
(function() {
  const eye = document.getElementById('sawyer-eye');
  if (!eye) return;
  const layers = {
    open:   eye.querySelector('.eye-open'),
    open2:  eye.querySelector('.eye-open2'),
    closed: eye.querySelector('.eye-closed'),
    angry:  eye.querySelector('.eye-angry'),
  };
  let current = 'open';
  let busy = false;

  function show(state) {
    Object.keys(layers).forEach(k => {
      if (layers[k]) layers[k].classList.toggle('active', k === state);
    });
    current = state;
  }

  function lookAt(clientX, clientY) {
    if (busy) return;
    const rect = eye.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const dx = (clientX - cx) / rect.width;
    const dy = (clientY - cy) / rect.height;
    const layer = layers[current];
    if (layer) {
      const nx = Math.max(-6, Math.min(6, dx * 10));
      const ny = Math.max(-5, Math.min(5, dy * 8));
      layer.style.transform = `translate(${nx}px, ${ny}px) scale(1.08)`;
    }
  }
  document.addEventListener('mousemove', e => lookAt(e.clientX, e.clientY));
  document.addEventListener('touchstart', e => {
    if (e.touches[0]) lookAt(e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: true });
  document.addEventListener('touchmove', e => {
    if (e.touches[0]) lookAt(e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: true });

  function blink() {
    if (busy) return;
    busy = true;
    show('closed');
    setTimeout(() => {
      show(Math.random() < 0.35 ? 'open2' : 'open');
      busy = false;
    }, 140);
  }

  function angryGlitch() {
    if (busy) return;
    busy = true;
    eye.classList.add('glitch');
    show('angry');
    setTimeout(() => {
      show('open');
      eye.classList.remove('glitch');
      busy = false;
    }, 450);
  }

  function scheduleBlink() {
    const delay = 1800 + Math.random() * 4200;
    setTimeout(() => {
      if (Math.random() < 0.12) angryGlitch();
      else {
        blink();
        if (Math.random() < 0.3) setTimeout(blink, 220);
      }
      scheduleBlink();
    }, delay);
  }
  scheduleBlink();

  setInterval(() => {
    if (!busy && current.startsWith('open') && Math.random() < 0.15) {
      show(current === 'open' ? 'open2' : 'open');
    }
  }, 900);

  eye.addEventListener('click', () => {
    angryGlitch();
    toast('The Doctor is watching…');
  });
})();

